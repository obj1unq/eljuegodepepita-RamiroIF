import wollok.game.*
import pepita.*
import extras.*
import direcciones.*
import comidas.*

program juego {
  game.title("Juego")
  game.width(16)
  game.height(12)
  game.cellSize(50)
  game.boardGround("fondo2.jpg")


  keyboard.up().onPressDo     ({ pepita.mover(arriba)    })
  keyboard.down().onPressDo   ({ pepita.mover(abajo)     })
  keyboard.left().onPressDo   ({ pepita.mover(izquierda) })
  keyboard.right().onPressDo  ({ pepita.mover(derecha)   })
  keyboard.c().onPressDo({ pepita.comer(game.uniqueCollider(pepita)) })


  game.addVisual(manzana)
  game.addVisual(alpiste)   // Esto se supone que no va aca
  game.addVisual(silvestre) // Deberia tener un archivo aparte ej (nivel 1)
  game.addVisual(pepita)    

  game.start()
}