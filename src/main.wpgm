import wollok.game.*
import pepita.*
import extras.*
import direcciones.*
import comidas.*
import muros.*
import nido.*

program juego {
  game.title("Juego")
  game.width(16)
  game.height(12)
  game.cellSize(50)
  game.boardGround("fondo2.jpg")


  keyboard.up().onPressDo     ({ pepita.mover(arriba)    })
  keyboard.down().onPressDo   ({ pepita.mover(abajo)     })
  keyboard.left().onPressDo   ({ pepita.mover(izquierda) })
  keyboard.right().onPressDo  ({ pepita.mover(derecha)   })

  keyboard.c().onPressDo({ try { pepita.comer(game.uniqueCollider(pepita)) } catch e : Exception { console.println("Aca no hay comida") } }) // TUTORIAL 3, no quiero una colision con mis comidas a menos que presione C

  game.onCollideDo(silvestre, { alguien => alguien.morir() }) // el game.stop() deberia estar aca o esta bien dentro de morir()?
  
  game.onCollideDo(nido, { alguien => alguien.ganar() })
  
  game.onTick(8000, "Perder altura por la gravedad", {pepita.descender()}) // Bonus tutorial 2

  game.addVisual(nido)
  game.addVisual(muro)
  game.addVisual(manzana)
  game.addVisual(alpiste)   // Esto y lo de arriba se supone que no va aca
  game.addVisual(silvestre) // Deberia tener un archivo aparte ej (nivel 1)
  game.addVisual(pepita)    

  game.start()
}